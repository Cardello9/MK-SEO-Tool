{% extends "base.html.twig" %}

{% block title %}Generuj raport{% endblock %}

{% block body %}
    <h1 class="mb-4">Generuj raport</h1>

    <form method="post" action="{{ path('app_report_generate') }}" class="row g-3">
        <div class="col-12">
            <label for="url" class="form-label">Adres URL strony</label>
            <input
                type="url"
                class="form-control form-control-lg"
                id="url"
                name="url"
                value="{{ url }}"
                placeholder="https://example.com"
                required
                inputmode="url"
                autocomplete="url"
            >
            <div class="form-text">Wpisz pełny adres strony do analizy SEO (z protokołem https:// lub http://).</div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary btn-lg">Generuj raport</button>
        </div>
    </form>
{% endblock %}
