{% extends "base.html.twig" %}

{% block title %}Generate report{% endblock %}

{% block body %}
    <h1 class="mb-4">Generate report</h1>

    <form method="post" action="{{ path('app_report_generate') }}" class="row g-3">
        <div class="col-12">
            <label for="url" class="form-label">Page URL</label>
            <input
                type="url"
                class="form-control form-control-lg"
                id="url"
                name="url"
                value="{{ url }}"
                placeholder="https://example.com"
                required
                inputmode="url"
                autocomplete="url"
            >
            <div class="form-text">Enter the full page URL for SEO analysis (including https:// or http://).</div>
        </div>
        <div class="col-12">
            <button type="submit" class="btn btn-primary btn-lg">Generate report</button>
        </div>
    </form>
{% endblock %}
